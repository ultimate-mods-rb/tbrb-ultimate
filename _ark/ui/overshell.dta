#define CHEATS_DATA
((
   {if_else $colorshuffle os_colorshuffle1 os_colorshuffle0}
   #ifndef HX_WII
   {if_else $flashbang os_flashbang1 os_flashbang0}
   #endif
   {if_else $bigmode os_bigmode1 os_bigmode0}
   {if_else $smallworld os_smallworld1 os_smallworld0}
   {if_else $greennday os_greenday1 os_greenday0}
   {if_else $hide_beatles os_hidebeatles1 os_hidebeatles0}
   {if_else $hide_insts os_hideinsts1 os_hideinsts0}
   {if_else $randomvenue os_randomvenue1 os_randomvenue0}
   {if_else $randomoutfit os_randomoutfit1 os_randomoutfit0}
   {if_else {== $forcevenue off} os_venues0 os_venues1}
   {if_else $forceoutfits os_outfits1 os_outfits0}
   {if_else {== $forceminivenue off} os_minivenues0 os_minivenues1}
   {if_else {== $forcescene off} os_scenes0 os_scenes1}
))
{new
   UIPanel
   overshell_cheats_panel
   OVERSHELL_LIST_FILE
   (enter
      {$this lst_reset}
      {title.lbl set text_token {localize os_cheats}})
   (SELECT_MSG
      {switch {$component selected_sym}
         ((os_colorshuffle1 os_colorshuffle0)
            {set $colorshuffle {! $colorshuffle}}
         )
         ((os_flashbang1 os_flashbang0)
            {set $flashbang {! $flashbang}}
         )
         ((os_bigmode1 os_bigmode0)
            {set $bigmode {! $bigmode}}
         )
         ((os_smallworld1 os_smallworld0)
            {set $smallworld {! $smallworld}}
         )
         ((os_greenday1 os_greenday0)
            {set $greennday {! $greennday}}
         )
         ((os_hidebeatles1 os_hidebeatles0)
            {set $hide_beatles {! $hide_beatles}}
         )
         ((os_hideinsts1 os_hideinsts0)
            {set $hide_insts {! $hide_insts}}
         )
         ((os_randomvenue1 os_randomvenue0)
            {set $randomvenue {! $randomvenue}}
            #ifndef HX_WII
            {passive_messages_panel queue_message cdlc_warning_message}
            #endif
         )
         ((os_randomoutfit1 os_randomoutfit0)
            {set $randomoutfit {! $randomoutfit}}
            #ifndef HX_WII
            {passive_messages_panel queue_message cdlc_warning_message}
            #endif
         )
         ((os_venues1 os_venues0)
            {pop_and_goto_screen overshell_venues_screen}
         )
         ((os_minivenues1 os_minivenues0)
            {pop_and_goto_screen overshell_minivenues_screen}
         )
         ((os_scenes1 os_scenes0)
            {pop_and_goto_screen overshell_scenes_screen}
         )
         ((os_outfits1 os_outfits0)
            #ifndef HX_WII
            {passive_messages_panel queue_message cdlc_warning_message}
            #endif
            {set $forceoutfits TRUE}
            {pop_and_goto_screen overshell_force_outfits_screen}
         )
      }
      {$this lst_reset}
   )
   (lst_reset
      {overshell.lst set_data CHEATS_DATA}
      {overshell.lst set_selected $chtmodifierpos})
   (SCROLL_MSG
      {set $chtmodifierpos {overshell.lst selected_pos}})
}
{new
   UIScreen
   overshell_cheats_screen
   (back overshell_main_screen)
   (panels overshell_cheats_panel)
   (focus overshell_cheats_panel)}
;
;

