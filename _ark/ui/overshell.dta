#define OVERSHELL_LIST_FILE
((file ../ulti/overshell.milo) (focus overshell.lst))
{func
   pop_and_goto_screen
   ($gotoscreen)
   {ui pop_screen}
   {ui goto_screen $gotoscreen}}
{new
   UIPanel
   overshell_main_panel
   OVERSHELL_LIST_FILE
   (enter
      {overshell.lst set_data (os_mod os_spd os_vis os_trk os_gfx os_cnt os_cheats)}
      {title.lbl set text_token os_ultisettings}
      {set $overshell_up TRUE}
      {set $chtmodifierpos 0}
      {set $cntmodifierpos 0}
      {set $trkmodifierpos 0}
      {set $gfxmodifierpos 0})
   (SELECT_MSG
      {switch {$component selected_sym}
         (os_spd
            {main_popup_bg_panel set screen training}
            {pop_and_goto_screen overshell_speed_screen}
         )
         (os_mod
            {pop_and_goto_screen overshell_modifier_screen}
         )
         (os_vis
            {pop_and_goto_screen overshell_visual_screen}
         )
         (os_gfx
            {pop_and_goto_screen overshell_graphics_screen}
         )
         (os_trk
            {pop_and_goto_screen overshell_trk_screen}
         )
         (os_cnt
            {pop_and_goto_screen overshell_cnt_screen}
         )
         (os_cheats
            {pop_and_goto_screen overshell_cheats_screen}
         )
      }
   )
   (BUTTON_DOWN_MSG
      {if {== $action kAction_Cancel}
         {ulti_settings_writer}
         {ui pop_screen}
         {set $overshell_up FALSE}
      }
      kDataUnhandled
   )
}
{new
   UIScreen
   overshell_main_screen
   (panels overshell_main_panel)
   (focus overshell_main_panel)}
;
#define MODIFIER_DATA
((
   {if_else $syncdifspeeds os_syncdifspeeds1 os_syncdifspeeds0}
   #ifndef HX_XBOX
   {if_else $whammypb os_whammypb1 os_whammypb0}
   #endif
   {if_else $trkmuting os_trkmuting1 os_trkmuting0}
   {if_else $nomisounds os_nomisounds1 os_nomisounds0}
   #ifndef HX_WII
   {if_else $skipintro os_skipintro1 os_skipintro0}
   #endif
   #ifdef HX_PS3
   {if_else $skipsplash os_skipsplash1 os_skipsplash0}
   #endif
))
{new
   UIPanel
   overshell_modifier_panel
   OVERSHELL_LIST_FILE
   (enter
      {$this lst_reset}
      {title.lbl set text_token {localize os_mod}})
   (exit
      {set $modifierpos 0})
   (SELECT_MSG
      {switch {$component selected_sym}
         ((os_syncdifspeeds1 os_syncdifspeeds0)
            {set $syncdifspeeds {! $syncdifspeeds}}
         )
         ((os_whammypb1 os_whammypb0)
            {set $whammypb {! $whammypb}}
         )
         ((os_trkmuting1 os_trkmuting0)
            {set $trkmuting {! $trkmuting}}
         )
         ((os_nomisounds1 os_nomisounds0)
            {set $nomisounds {! $nomisounds}}
         )
         ((os_skipintro1 os_skipintro0)
            {set $skipintro {! $skipintro}}
         )
         ((os_skipsplash1 os_skipsplash0)
            {set $skipsplash {! $skipsplash}}
         )
      }
      {$this lst_reset}
   )
   (lst_reset
      {overshell.lst set_data MODIFIER_DATA}
      {if $modifierpos
         {overshell.lst set_selected $modifierpos}})
   (SCROLL_MSG
      {set $modifierpos {overshell.lst selected_pos}})
}
{new
   UIScreen
   overshell_modifier_screen
   (back overshell_main_screen)
   (panels overshell_modifier_panel)
   (focus overshell_modifier_panel)}

;
#define VIS_MODIFIER_DATA
((
   {if_else $songtitle os_songtitle1 os_songtitle0}
   {if_else $showauthor os_showauthor1 os_showauthor0}
   {if_else $progressbar os_progressbar1 os_progressbar0}
   {if_else $goldprogress os_goldprogress1 os_goldprogress0}
   {if_else $fcring os_fcring1 os_fcring0}
   {if_else $legacybass os_legacybass1 os_legacybass0}
   #ifdef HX_PS3
   {if_else $skipnetwarning os_skipnetwarning1 os_skipnetwarning0}
   #endif
))
{new
   UIPanel
   overshell_visual_panel
   OVERSHELL_LIST_FILE
   (enter
      {$this lst_reset}
      {title.lbl set text_token {localize os_vis}})
   (exit
      {set $vismodifierpos 0})
   (SELECT_MSG
      {switch {$component selected_sym}
         ((os_songtitle1 os_songtitle0)
            {set $songtitle {! $songtitle}}
         )
         ((os_showauthor1 os_showauthor0)
            {set $showauthor {! $showauthor}}
         )
         ((os_fcring1 os_fcring0)
            {set $fcring {! $fcring}}
         )
         ((os_progressbar1 os_progressbar0)
            {set $progressbar {! $progressbar}}
         )
         ((os_goldprogress1 os_goldprogress0)
            {set $goldprogress {! $goldprogress}}
         )
         ((os_legacybass1 os_legacybass0)
            {set $legacybass {! $legacybass}}
         )
         ((os_skipnetwarning1 os_skipnetwarning0)
            {set $skipnetwarning {! $skipnetwarning}}
         )
      }
      {$this lst_reset}
   )
   (lst_reset
      {overshell.lst set_data VIS_MODIFIER_DATA}
      {if $vismodifierpos
         {overshell.lst set_selected $vismodifierpos}})
   (SCROLL_MSG
      {set $vismodifierpos {overshell.lst selected_pos}})}
{new
   UIScreen
   overshell_visual_screen
   (back overshell_main_screen)
   (panels overshell_visual_panel)
   (focus overshell_visual_panel)}
;
;
#define GFX_MODIFIER_DATA
((
   #ifndef HX_WII
   os_venuefps
   os_vsync
   {if_else $forcelod0 os_forcelod01 os_forcelod00}
   #endif
   #ifdef HX_WII
   {if_else $disablegfx os_disablegfx1 os_disablegfx0}
   {if_else $notriframe os_notriframe1 os_notriframe0}
   {if_else $60fps os_60fps os_30fps}
   #endif
   {if_else $blackbg os_blackbg1 os_blackbg0}
   {if_else $postfx os_postfx1 os_postfx0}
   {if_else $fxdof os_fxdof1 os_fxdof0}
   {if_else $scrnoise os_scrnoise1 os_scrnoise0}
   {if_else $scrbloom os_scrbloom1 os_scrbloom0}
   {if_else $camerashake os_camerashake1 os_camerashake0}
   #ifndef HX_WII
   {if_else $mbblend os_mbblend1 os_mbblend0}
   #endif
))
{new
   UIPanel
   overshell_graphics_panel
   OVERSHELL_LIST_FILE
   (enter
      {$this lst_reset}
      {title.lbl set text_token {localize os_gfx}})
   (SELECT_MSG
      {switch {$component selected_sym}
         ((os_forcelod01 os_forcelod00)
            {set $forcelod0 {! $forcelod0}}
         )
         ((os_disablegfx1 os_disablegfx0)
            {set $disablegfx {! $disablegfx}}
            {rnd toggle_all_postprocs}
         )
         ((os_notriframe1 os_notriframe0)
            {set $notriframe {! $notriframe}}
         )
         ((os_60fps os_30fps)
            {set $60fps {! $60fps}}
         )
         ((os_postfx1 os_postfx0)
            {set $postfx {! $postfx}}
            #ifdef HX_WII
            {pp_override}
            #else
            {rnd toggle_all_postprocs}
            #endif
         )
         ((os_scrnoise1 os_scrnoise0)
            {set $scrnoise {! $scrnoise}}
         )
         ((os_scrbloom1 os_scrbloom0)
            {set $scrbloom {! $scrbloom}}
         )
         ((os_camerashake1 os_camerashake0)
            {set $camerashake {! $camerashake}}
         )
         ((os_mbblend1 os_mbblend0)
            {set $mbblend {! $mbblend}}
         )
         ((os_fxdof1 os_fxdof0)
            {set $fxdof {! $fxdof}}
         )
         (os_venuefps
            {pop_and_goto_screen overshell_venuefps_screen}
         )
         (os_vsync
            {pop_and_goto_screen overshell_vsync_screen}
         )
         ((os_blackbg1 os_blackbg0)
            {set $blackbg {! $blackbg}}
         )
      }
      {$this lst_reset}
   )
   (lst_reset
      {overshell.lst set_data GFX_MODIFIER_DATA}
      {if $gfxmodifierpos
         {overshell.lst set_selected $gfxmodifierpos}})
   (SCROLL_MSG
      {set $gfxmodifierpos {overshell.lst selected_pos}})}
{new
   UIScreen
   overshell_graphics_screen
   (back overshell_main_screen)
   (panels overshell_graphics_panel)
   (focus overshell_graphics_panel)}
;
{new
   UIPanel
   overshell_vsync_panel
   OVERSHELL_LIST_FILE
   (enter
      {overshell.lst set_data (infinite full half quarter)}
      {title.lbl set text_token {localize os_vsync}}
      {overshell.lst set_selected {switch $vsyncrate (0 0) (1 1) (2 2) (4 3)}})
   (exit
      {rnd set_sync $vsyncrate})
   (SELECT_MSG
      {switch {$component selected_sym}
         (infinite
            {set $vsyncrate 0}
         )
         (full
            {set $vsyncrate 1}
         )
         (half
            {set $vsyncrate 2}
         )
         (quarter
            {set $vsyncrate 4}
         )
      }
      {pop_and_goto_screen overshell_graphics_screen}
   )}
{new
   UIScreen
   overshell_vsync_screen
   (back overshell_graphics_screen)
   (panels overshell_vsync_panel)
   (focus overshell_vsync_panel)}
{new
   UIPanel
   overshell_venuefps_panel
   OVERSHELL_LIST_FILE
   (enter
      {overshell.lst set_data (60fps 30fps 24fps 15fps 12fps 6fps 1fps)}
      {title.lbl set text_token {localize os_venuefps}}
      {overshell.lst set_selected {switch $emulatefps (60 0) (30 1) (24 2) (15 3) (12 4) (6 5) (1 6)}})
   (SELECT_MSG
      {switch {$component selected_sym}
         (60fps
            {set $emulatefps 60}
         )
         (30fps
            {set $emulatefps 30}
         )
         (24fps
            {set $emulatefps 24}
         )
         (15fps
            {set $emulatefps 15}
         )
         (12fps
            {set $emulatefps 12}
         )
         (6fps
            {set $emulatefps 6}
         )
         (1fps
            {set $emulatefps 1}
         )
      }
      {pop_and_goto_screen overshell_graphics_screen}
   )}
{new
   UIScreen
   overshell_venuefps_screen
   (back overshell_graphics_screen)
   (panels overshell_venuefps_panel)
   (focus overshell_venuefps_panel)}
;
;

#define CNT_MODIFIER_DATA
((
   os_remap_cnt
   #ifndef HX_WII
   os_force_inst_detec
   #endif
   {if_else $padtar os_padtar1 os_padtar0}
   {if_else $paddrum os_paddrum1 os_paddrum0}
   {if_else $secondkick os_secondkick1 os_secondkick0}
   {if_else $os_igc os_blnk {if_else $autokick os_autokick1 os_autokick0}}
))
{new
   UIPanel
   overshell_cnt_panel
   OVERSHELL_LIST_FILE
   (enter
      {$this lst_reset}
      {title.lbl set text_token {localize os_cnt}}
      {set $rcntmodifierpos 0})
   (SELECT_MSG
      {switch {$component selected_sym}
         (os_remap_cnt
            {pop_and_goto_screen overshell_remap_cnt_screen}
         )
         (os_force_inst_detec
            {pop_and_goto_screen overshell_force_inst_detec_screen}
         )
         ((os_padtar1 os_padtar0)
            {set $padtar {! $padtar}}
            {set $paddrum FALSE}
            {set_cnt_type wii_remote {if_else $padtar kControllerGuitar kControllerVocals}}
            {set_cnt_type dualshock {if_else $padtar kControllerGuitar kControllerVocals}}
            {set_cnt_type analog {if_else $padtar kControllerGuitar kControllerVocals}}
         )
         ((os_paddrum1 os_paddrum0)
            {set $paddrum {! $paddrum}}
            {set $padtar FALSE}
            {set_cnt_type wii_remote {if_else $paddrum kControllerDrum kControllerVocals}}
            {set_cnt_type dualshock {if_else $paddrum kControllerDrum kControllerVocals}}
            {set_cnt_type analog {if_else $paddrum kControllerDrum kControllerVocals}}
         )
         ((os_secondkick1 os_secondkick0)
            {set $secondkick {! $secondkick}}
            {if_else $secondkick
               {enable_second_kick_mapping}
               {disable_second_kick_mapping}
            }
         )
         ((os_autokick1 os_autokick0)
            {set $autokick {! $autokick}}
         )
      }
      {$this lst_reset}
   )
   (lst_reset
      {overshell.lst set_data CNT_MODIFIER_DATA}
      {if $cntmodifierpos
         {overshell.lst set_selected $cntmodifierpos}})
   (SCROLL_MSG
      {set $cntmodifierpos {overshell.lst selected_pos}})}
{new
   UIScreen
   overshell_cnt_screen
   (back overshell_main_screen)
   (panels overshell_cnt_panel)
   (focus overshell_cnt_panel)}
;
;could probably clean up a bit more at some point
{new
   UIPanel
   overshell_speed_panel
   (file
      "options/options_audio.milo")
   (focus background_music.btn)
   (enter
      {audio_options.lbl set text_token os_spd}
      {$this set_slider_steps}
      {$this hide_unused_btns}
      {$this update_btn_ints}
      {$this update_all_sliders})
   (TRANSITION_COMPLETE_MSG
      {$this
         update_helpbar
         {$this focus_name}}
      kDataUnhandled)
   (FOCUS_MSG
      {$this update_helpbar $new_focus})
   (SCROLL_SELECT_MSG
      {$this set_speeds})
   (SCROLL_MSG
      {$this set_speeds})
   (SELECT_MSG
      {switch
         $component
         (background_music.btn
            {background.sld store}
            {$this set_focus background.sld})
         (crowd.btn
            {crowd.sld store}
            {$this set_focus crowd.sld})
         (sfx.btn
            {sfx.sld store}
            {$this set_focus sfx.sld})})
   (BUTTON_DOWN_MSG
      {switch
         {$this focus_name}
         (background.sld
            {switch
               $action
               (kAction_Confirm
                  {background.sld confirm}
                  {$this set_focus background_music.btn})
               (kAction_Cancel
                  {background.sld undo $user}
                  {$this set_focus background_music.btn})
               kDataUnhandled})
         (crowd.sld
            {switch
               $action
               (kAction_Confirm
                  {crowd.sld confirm}
                  {$this set_focus crowd.btn})
               (kAction_Cancel
                  {crowd.sld undo $user}
                  {$this set_focus crowd.btn})
               kDataUnhandled})
         (sfx.sld
            {switch
               $action
               (kAction_Confirm
                  {sfx.sld confirm}
                  {$this set_focus sfx.btn})
               (kAction_Cancel
                  {sfx.sld undo $user}
                  {$this set_focus sfx.btn})
               kDataUnhandled})
         kDataUnhandled})
   (update_all_sliders
      {$this
         iterate
         UISlider
         $s
         {$this update_sliders $s}})
   (update_sliders
      ($component)
      {switch
         $component
         (background.sld
            {$component
               set_current
               {int {+ 0.5 {/ {+ {- $trackspeed 1} 0.5} 0.05}}}})
         (crowd.sld
            {$component
               set_current
               {int {+ 0.5 {/ {- $speedmod 1} 0.05}}}})
         (sfx.sld
            {$component
               set_current
               {int {+ 0.5 {/ {+ {- $hwlength 1} 0.5} 0.05}}}})})
   (set_speeds
      {set $trackspeed
         {- {+ 1 {* {background.sld current} 0.05}} 0.5}}
      {set $speedmod
         {+ 1 {* {crowd.sld current} 0.05}}}
      {set $hwlength
         {- {+ 1 {* {sfx.sld current} 0.05}} 0.5}}
      {$this update_btn_ints})
   (set_slider_steps
      {background.sld set_num_steps 41}
      {crowd.sld set_num_steps 31}
      {sfx.sld set_num_steps 41})
   (hide_unused_btns
      {$this disable karaoke.btn}
      {karaoke.btn set_showing FALSE}
      {delete check.mesh}
      {delete checkbox.mesh})
   (update_btn_ints
      {background_music.btn set text_token {sprintf {localize trackspeed_msg} {int {+ 0.5 {* $trackspeed 100}}}}}
      {crowd.btn set text_token {sprintf {localize speed_msg} {int {+ 0.5 {* $speedmod 100}}}}}
      {sfx.btn set text_token {sprintf {localize hwlength_msg} {int {+ 0.5 {* $hwlength 100}}}}})
   (update_helpbar
      ($new_focus)
      {switch
         $new_focus
         ((background_music.btn crowd.btn sfx.btn)
            {helpbar
               set_config
               ((cancel helpbar_back)
                  (confirm helpbar_changesetting))})
         ((background.sld crowd.sld sfx.sld)
            {helpbar
               set_config
               ((cancel helpbar_cancel)
                  (confirm helpbar_confirmsetting))})})}
{new
   UIScreen
   overshell_speed_screen
   (back overshell_main_screen)
   (panels main_popup_bg_panel overshell_speed_panel)
   (focus overshell_speed_panel)}
;
#define TRK_MODIFIER_DATA
((
