#define TBRB_OUTFITS_MODIFIER_DATA
((none budokan01 budokan02 cavern cavern02 love love_alt love_hdp revolver01 revolver01_alt revolver01_hdp rooftop sgtpepper02 sgtpepper03 sgtpepper03_hdp sgtpepper03_alt sgtpepper03_alt_hdp sgtpepper sgtpepper_alt shea sixtyeight02 sixtyeight02_hdp sixtyeight sixtyeight_hdp sixtynine sixtynine_hdp straw straw_alt sullivan walrus01 walrus02 yellow01 #ifdef HX_WII sullivan02 sullivan03 #endif))
{new UIPanel
   overshell_force_outfits_panel
   OVERSHELL_LIST_FILE
   (pos)
   (enter
      {overshell.lst set_data (ringo george john paul)}
      {overshell.lst set_selected [pos]}
      {title.lbl set text_token {localize os_outfits}}
   )
   (SELECT_MSG
      {set $os_char {$component selected_sym}}
      {overshell_char_panel set pos 0}
      {pop_and_goto_screen overshell_char_screen}
   )
   (SCROLL_MSG {set [pos] {overshell.lst selected_pos}})
}
{new UIScreen
   overshell_force_outfits_screen
   (back overshell_cheats_screen)
   (panels overshell_force_outfits_panel)
   (focus overshell_force_outfits_panel)
}
{new UIPanel
   overshell_char_panel
   OVERSHELL_LIST_FILE
   (pos)
   (enter
      {overshell.lst set_data (os_outfit os_inst1 os_inst2 os_inst3 os_inst4)}
      {overshell.lst set_selected [pos]}
      {title.lbl set text_token $os_char}
   )
   (SELECT_MSG
      {set $os_var [pos]}
      {if_else [pos]
         {pop_and_goto_screen overshell_insts_screen}
         {pop_and_goto_screen overshell_outfits_screen}
      }
   )
   (SCROLL_MSG {set [pos] {overshell.lst selected_pos}})
}
{new UIScreen
   overshell_char_screen
   (back overshell_force_outfits_screen)
   (panels overshell_char_panel)
   (focus overshell_char_panel)
}
{new UIPanel
   overshell_outfits_panel
   OVERSHELL_LIST_FILE
   (enter
      {overshell.lst set_data TBRB_OUTFITS_MODIFIER_DATA}
      {title.lbl set text_token os_outfit}
   )
   (SELECT_MSG
      {set_elem {switch $os_char (ringo $rArray) (george $gArray) (john $jArray) (paul $pArray)} 0 {$component selected_sym}}
      {pop_and_goto_screen overshell_char_screen}
   )
}
{new UIScreen
   overshell_outfits_screen
   (back overshell_char_screen)
   (panels overshell_outfits_panel)
   (focus overshell_outfits_panel)
}
{new UIPanel
   overshell_insts_panel
   OVERSHELL_LIST_FILE
   (enter
      {overshell.lst set_data $instsArray}
      {title.lbl set text_token {localize {sprint "os_inst" $os_var}}}
   )
   (SELECT_MSG
      {set_elem {switch $os_char (ringo $rArray) (george $gArray) (john $jArray) (paul $pArray)} $os_var {$component selected_sym}}
      {pop_and_goto_screen overshell_char_screen}
   )
}
{new UIScreen
   overshell_insts_screen
   (back overshell_char_screen)
   (panels overshell_insts_panel)
   (focus overshell_insts_panel)
}