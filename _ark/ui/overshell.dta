      {overshell.lst set_data (info off guitar #ifdef HX_PS3 gh_guitar #endif drum)}
      {title.lbl set text_token {localize os_force_inst_detec}})
   (SELECT_MSG
      {switch {$component selected_sym}
         (info
            {ui push_screen force_instrument_info_screen}
