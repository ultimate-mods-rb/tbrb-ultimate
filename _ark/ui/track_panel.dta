#include ../ulti/track/track_funcs.dta
#include ../ulti/track/track_macros.dta
#define TRACK_END_FRAME
(1920)
#define TRACK_PANEL_HANDLERS
((enter
      {do
         ($bar progress.sld)
         ($wide {== {rnd aspect} kWidescreenAspect})
         ($h2h {gamemode in_mode h2h})
         ($vox
            {if_else $h2h
               {== {{game get_participant_config 0} get_track_sym} vocals}
               {{$this loaded_dir} get vocals}
            }
         )
         ($gem
            {if_else $h2h
               {! $vox}
               {||
                  {{$this loaded_dir} get bass}
                  {{$this loaded_dir} get drum}
                  {{$this loaded_dir} get guitar}
               }
            }
         )
         ($x
            {cond
               ({&& $h2h $vox} 0)
               ($h2h -0.34)
               ($wide 4.1)
               2.8
            }
         )
         ($y 
            {cond
               ({&& $h2h {! $wide} $gem} 11)
               ($h2h 8)
               10
            }
         )
         ($z
            {cond
               ({&& $h2h $vox} 1.54)
               ($h2h 2.4)
               ({&& $gem $vox} 0.47)
               ($vox 1.39)
               1.86
            }
         )
         ($s 0.006)
         {$bar set_showing FALSE}
         {$this disable $bar}
         {$bar set_num_steps 100}
         {$bar set_local_pos $x $y $z}
         {$bar set_local_scale $s $s $s}
      }
      {unless {exists fc_bass_callback}
         FC_CALLBACKS}
      {game add_sink $this}
      SET_TRACK_SPEEDS
      {$this
         set_showing
         {'||'
            $skip_intro
            {gamemode in_mode drum_trainer}
            {!
               {gamemode in_mode practice}}}}
      #ifdef HX_WII
      {if_else $notriframe
         {rnd tri_frame 0}
         {do
            ($vocals 0)
            ($gems 0)
            ($tri_frame 0)
            {beatmatch
               foreach_active_player
               $player
               {if_else
                  {==
                     {$player instrument}
                     vocals}
                  {'++' $vocals}
                  {'++' $gems}}}
            {if
               {'||'
                  {&&
                     $vocals
                     {== $gems 1}}
                  {&&
                     {== $vocals 0}
                     {>= $gems 2}}}
               {set
                  $tri_frame
                  {song_mgr
                     tri_frame
                     {meta_performer song}}}}
            {if
               {&&
                  $vocals
                  {>= $gems 2}}
               {set $tri_frame 1}}
            {rnd tri_frame $tri_frame}}}
      {rnd frames_buffered 2}
      #endif)
   (exit
      #ifdef HX_WII
      {rnd frames_buffered 1}
      #endif
      {game remove_sink $this})
   (unison_hit)
   (unison_miss)
   (set_track_out)
   (set_track_in)
   (animate_track
      ($start $end $period $units))
   (animate_track_out)
   (animate_track_out_fast)
   (animate_track_in_fast)
   (finish_load
      {$this
         set_showing
         {!
            {gamemode in_mode theatre}}}
      {$this set_track_out})
   (intro_start
      {$this track_reset}
      {$this
         set_showing
         {!
            {gamemode in_mode theatre}}}
      {$this set_track_in})
   (intro_skip
      {$this track_reset}
      {$this set_showing TRUE}
      {$this set_track_out}
      {if
         {&&
            {exists gamemode}
            {!
               {gamemode get is_tutorial}}}
         {$this play_intro}})
   (on_reset
      {beatmatch
         foreach_active_player
         $m
         {$m on_new_track}
         {{$m track}
            init
            {$m track}}}
      {{$this loaded_dir}
         reset})
   (on_extend
      {foreach $callback (fc_vocals_callback fc_vocals_callback_1)
         {$callback reset}
      }
      ADD_FC_CALLBACKS
      SET_TRACK_TEXTURES
      {$this play_intro}
      {if
         {&&
            {exists gamemode}
            {gamemode get play_track_intro_sfx}}
         {synth play track_beg.cue}}
      {if_else
         {== {gamemode in_mode} practice}
         {do
            {unless {> {gamecfg get practice_speed} 0} {beatmatch set_music_speed $speedmod}}
            {if {> {gamecfg get practice_speed} 0} {beatmatch set_music_speed $modifier}}
         }
         {beatmatch set_music_speed $speedmod}
      }
      {progress.sld set_showing $progressbar}
   )
   (poll {progress.sld set_current {{beatmatch main_performer} percent_complete}})
)
{new
   TrackPanel
   coop_track_panel
   (file
      "track/trackpanel.milo")
   TRACK_PANEL_HANDLERS}
{new
   TrackPanel
   h2h_track_panel
   (file
      "track/trackpanel_h2h.milo")
   TRACK_PANEL_HANDLERS}
{func
   get_track_panel
   {gamemode get track_panel}}
{set
   $playback_file
   ""}
