#ifdef HX_WII
#include ulti_settings_rw_wii.dta
#else
#include ulti_settings_rw.dta
#endif
{func
   modifier_funcs
   {if $postfx
      #ifdef HX_WII {pp_override} #else {rnd toggle_all_postprocs} #endif}
   {if $padtar
      #ifdef HX_PS3
      {set_cnt_type dualshock kControllerGuitar}
      #endif
      #ifdef HX_WII
      {set_cnt_type wii_remote kControllerGuitar}
      #endif
      {set_cnt_type analog kControllerGuitar}}
   {if $paddrum
      #ifdef HX_PS3
      {set_cnt_type dualshock kControllerDrum}
      #endif
      #ifdef HX_WII
      {set_cnt_type wii_remote kControllerDrum}
      #endif
      {set_cnt_type analog kControllerDrum}}
   #ifndef HX_WII
   {if $force_inst_detec
      {force_inst_detection}}
   #endif
   {set_cnt_mapping}

   {unless {== $highway none} {set $highwaycustomtexture TRUE}}

   {unless {== $spotlight none} {set $spotlightcustomtexture TRUE}}

   {unless {== $streak none} {set $streakcustomtexture TRUE}}

   {profile_mgr set_mic_gain 0 $mic_gain_1} {profile_mgr update_mic_gain 0}

   {profile_mgr set_mic_gain 1 $mic_gain_2} {profile_mgr update_mic_gain 1}

   {profile_mgr set_mic_gain 2 $mic_gain_3} {profile_mgr update_mic_gain 2}

   #ifndef HX_WII
   {rnd set_sync $vsyncrate}
   #endif}
{func
   game_exit_handler
   {if_else
      {== {meta_performer get_venue} dreamscape}
      {if_else
         {'||'
            {!= $forcescene off}
            {!= $forceminivenue off}
            $ngskillissue
         }
         {script_task
            kTaskSeconds
            (delay 2)
            (script
               {$this game_outro}
            )
         }
         kDataUnhandled
      }
      kDataUnhandled
   }
}

#ifdef HX_WII
{func ;this is a little hacky i'd say find a better way of doing this but i tried like 100 and this was the most reliable lol
   exec_song_scripting
   #include ../ulti/song_updates/song_scripting.dta
}
#endif
{func
   set_cnt_type
   ($cnt $instr)
   {set_elem {find $syscfg joypad instrument_mapping $cnt} 1 $instr}
}
{func
   set_cnt_mapping
   #ifdef HX_WII
   {set_elem {find $syscfg beatmatcher controller wii_remote slots} 1 $cnt_slot1}
   {set_elem {find $syscfg beatmatcher controller wii_remote slots} 3 $cnt_slot2}
   {set_elem {find $syscfg beatmatcher controller wii_remote slots} 5 $cnt_slot3}
   {set_elem {find $syscfg beatmatcher controller wii_remote slots} 7 $cnt_slot4}
   {set_elem {find $syscfg beatmatcher controller wii_remote slots} 9 $cnt_slot5}
   {set_elem {find $syscfg beatmatcher controller wii_remote force_mercury} 1 $cnt_star}
   #else
   {set_elem {find $syscfg beatmatcher controller joypad slots} 1 $cnt_slot1}
   {set_elem {find $syscfg beatmatcher controller joypad slots} 3 $cnt_slot2}
   {set_elem {find $syscfg beatmatcher controller joypad slots} 5 $cnt_slot3}
   {set_elem {find $syscfg beatmatcher controller joypad slots} 7 $cnt_slot4}
   {set_elem {find $syscfg beatmatcher controller joypad slots} 9 $cnt_slot5}
   {set_elem {find $syscfg beatmatcher controller joypad force_mercury} 1 $cnt_star}
   #endif
}
{func
   enable_second_kick_mapping
   #ifdef HX_XBOX
   {insert_elems {find $syscfg beatmatcher controller hx_drums_xbox slots} 1 (kPad_R1 0)}
   {insert_elems {find $syscfg beatmatcher controller hx_drums_xbox_rb2 slots} 1 (kPad_R1 0)}
   #endif
   #ifdef HX_PS3
   {insert_elems {find $syscfg beatmatcher controller hx_drums_ps3 slots} 1 (kPad_R1 0)}
   #endif
   #ifdef HX_WII
   {insert_elems {find $syscfg beatmatcher controller wii_drums slots} 1 (kPad_R1 0)}
   #endif
}
{func
   disable_second_kick_mapping
   #ifdef HX_XBOX
   {set_elem {find $syscfg beatmatcher controller hx_drums_xbox slots} 1 69}
   {set_elem {find $syscfg beatmatcher controller hx_drums_xbox_rb2 slots} 1 69}
   #endif
   #ifdef HX_PS3
   {set_elem {find $syscfg beatmatcher controller hx_drums_ps3 slots} 1 69}
   #endif
   #ifdef HX_WII
   {set_elem {find $syscfg beatmatcher controller wii_drums slots} 1 69}
   #endif
}
{func
   reset_fc_vars
   {set $guitar_milosong FALSE} {set $bass_milosong FALSE} {set $drum_milosong FALSE} {set $h2h_0_milosong FALSE} {set $h2h_1_milosong FALSE}
   {set $guitar_firstnote FALSE} {set $bass_firstnote FALSE} {set $drum_firstnote FALSE} {set $h2h_0_firstnote FALSE} {set $h2h_1_firstnote FALSE}
   {set $guitar_groove_active FALSE} {set $drum_groove_active FALSE} {set $h2h_0_groove_active FALSE} {set $h2h_1_groove_active FALSE}
}
{func
   force_inst_detection
   {set $padtar FALSE}
   {set $paddrum FALSE}
   {if_else $force_inst_detec
      {switch $force_inst_detec
         (guitar
            {set_elem {find $syscfg joypad instrument_mapping analog} 1 kControllerGuitar}
            #ifdef HX_PS3
            {set_elem {find $syscfg joypad instrument_mapping dualshock} 1 kControllerGuitar}
            {set_elem {find $syscfg joypad controller_mapping dualshock} 1 hx_guitar_ps3}
            {set_elem {find $syscfg joypad controller_mapping analog} 1 hx_guitar_ps3}
            #else
            {set_elem {find $syscfg joypad controller_mapping analog} 1 ro_guitar_xbox}
            #endif
         )
         #ifdef HX_PS3
         (gh_guitar
            {set_elem {find $syscfg joypad instrument_mapping dualshock} 1 kControllerGuitar}
            {set_elem {find $syscfg joypad controller_mapping dualshock} 1 ro_guitar_ps3}
            {set_elem {find $syscfg joypad instrument_mapping analog} 1 kControllerGuitar}
            {set_elem {find $syscfg joypad controller_mapping analog} 1 ro_guitar_ps3}
         )
         #endif
         (drum
            {set_elem {find $syscfg joypad instrument_mapping analog} 1 kControllerDrum}
            #ifdef HX_PS3
            {set_elem {find $syscfg joypad instrument_mapping dualshock} 1 kControllerDrum}
            {set_elem {find $syscfg joypad controller_mapping dualshock} 1 hx_drums_ps3}
            {set_elem {find $syscfg joypad controller_mapping analog} 1 hx_drums_ps3}
            #else
            {set_elem {find $syscfg joypad controller_mapping analog} 1 hx_drums_xbox}
            #endif
         )
      }
      {do
         #ifdef HX_PS3
         {set_elem {find $syscfg joypad instrument_mapping dualshock} 1 kControllerVocals}
         {set_elem {find $syscfg joypad controller_mapping dualshock} 1 joypad}
         #endif
         {set_elem {find $syscfg joypad instrument_mapping analog} 1 kControllerVocals}
         {set_elem {find $syscfg joypad controller_mapping analog} 1 joypad}
      }
   }
}
{func get_author_info
   {if_else $showauthor
      {do
         {set $authorvar FALSE}
         {set $author_text FALSE}
         {set $songvar {meta_performer song}}
         {foreach $entry SONG_AUTHOR_INFO
            {if {== {elem $entry 0} $songvar}
               {set $authorvar
                  {elem {find $entry author} 1}
               }
            }
         }
         #ifdef HX_NG
         {if {! $authorvar}
            {set $song_dta_path {sprint {song_mgr song_path {symbol $songvar}} "songs.dta"}}
            {search_replace $song_dta_path {sprint $songvar "/" $songvar} "" $song_dta_path}
            {if {file_exists $song_dta_path}
               {foreach $entry {read_file $song_dta_path}
                  {if {== {elem $entry 0} $songvar}
                     {if {find $entry author}
                        {set $authorvar
                           {elem {find $entry author} 1}
                        }
                     }
                  }
               }
            }
         }
         #endif
         {if $authorvar
            {set $author_text {sprint " | Author: " $authorvar}}
         }
      }
      {set $author_text FALSE}
   }
}
#ifdef HX_NG
{func update_gems
   {switch $gems
      ((rb1 rb2)
         {set $custom_ts {load_objects {sprintf "ulti/track/tracksystems/%s/tracksystem.milo" $gems}}}
         {{$custom_ts find prism_mat.mat} set use_environ FALSE}
         {foreach $gtr (guitar bass)
            {with {coop_track_panel find $gtr}
               {foreach $color (green red yellow blue orange)
                  {do
                     ($wid {sprintf "gem_%s.wid" $color})
                     ($hopo_wid {sprintf "gem_%s_hopo.wid" $color})
                     {$wid copy {$custom_ts find $wid} kCopyDeep}
                     {$hopo_wid copy {$custom_ts find $hopo_wid} kCopyDeep}
                  }
               }
               {foreach $wid (star_gem.wid star_hopo.wid gem_miss.wid gem_miss_hopo.wid)
                  {$wid copy {$custom_ts find $wid} kCopyDeep}
               }
            }
         }
         {with {coop_track_panel find drum}
            {foreach $color (red yellow blue green star)
               {do
                  ($wid {sprintf "drum_%s.wid" $color})
                  {$wid copy {$custom_ts find $wid} kCopyDeep}
               }
            }
            {foreach $wid (gem_kick.wid star_kick.wid drum_miss.wid)
               {$wid copy {$custom_ts find $wid} kCopyDeep}
            }
         }
      )
      (lrb
         {set $custom_ts {load_objects "ulti/track/tracksystems/lrb/gems.milo"}}
         {foreach $gtr (guitar bass)
            {with {{get_track_panel} find $gtr}
               {prism_gem_stepped_miss.mesh copy {$custom_ts find lego_gem_guitar_mis_body.mesh} kCopyDeep}
               {prism_gem_stepped_style.mesh copy {$custom_ts find lego_gem_guitar_nrg_body.mesh} kCopyDeep}
               {prism_gem_stepped_orange.mesh copy {$custom_ts find lego_gem_guitar_ora_body.mesh} kCopyDeep}
               {prism_gem_stepped_blue.mesh copy {$custom_ts find lego_gem_guitar_blu_body.mesh} kCopyDeep}
               {prism_gem_stepped_yellow.mesh copy {$custom_ts find lego_gem_guitar_yel_body.mesh} kCopyDeep}
               {prism_gem_stepped_red.mesh copy {$custom_ts find lego_gem_guitar_red_body.mesh} kCopyDeep}
               {prism_gem_stepped_green.mesh copy {$custom_ts find lego_gem_guitar_grn_body.mesh} kCopyDeep}

               {prism_gem_hopo_miss.mesh copy {$custom_ts find lego_gem_ham_mis_body.mesh} kCopyDeep}
               {prism_gem_hopo_style.mesh copy {$custom_ts find lego_gem_ham_nrg_body.mesh} kCopyDeep}
               {prism_gem_hopo_orange.mesh copy {$custom_ts find lego_gem_ham_ora_body.mesh} kCopyDeep}
               {prism_gem_hopo_blue.mesh copy {$custom_ts find lego_gem_ham_blu_body.mesh} kCopyDeep}
               {prism_gem_hopo_yellow.mesh copy {$custom_ts find lego_gem_ham_yel_body.mesh} kCopyDeep}
               {prism_gem_hopo_red.mesh copy {$custom_ts find lego_gem_ham_red_body.mesh} kCopyDeep}
               {prism_gem_hopo_green.mesh copy {$custom_ts find lego_gem_ham_grn_body.mesh} kCopyDeep}


               {foreach $color (green red yellow blue orange)
                  {do
                     ($wid {sprintf "gem_%s.wid" $color})
                     ($hopo_wid {sprintf "gem_%s_hopo.wid" $color})
                     {if {== {size {$wid get_array meshes}} 2}
                        {$wid remove (meshes 1)}
                        {$hopo_wid remove (meshes 1)}
                     }
                  }
               }

               {foreach $starwid (star_gem.wid star_hopo.wid)
                  {if {== {size {$starwid get_array meshes}} 2}
                     {$starwid remove (meshes 1)}
                  }
               }

               {foreach $misswid (gem_miss.wid gem_miss_hopo.wid)
                  {if {== {size {$misswid get_array meshes}} 2}
                     {$misswid remove (meshes 0)}
                  }
               }
            }
         }
         {with {{get_track_panel} find drum}
            {foreach $mat (track_gems.mat prism_mat.mat prism_mat_glow.mat) ; dynamic_crash_green.mat dynamic_crash_red.mat
               {with {$custom_ts find $mat}
                  {set [prelit] FALSE}
                  {set [use_environ] FALSE}
               }
            }

            ; the dynamic_crash_*.meshes don't work.
            {drum_red_deploy.mesh copy {$custom_ts find lego_gem_drum_red_body.mesh} kCopyDeep}
            {drum_green_deploy.mesh copy {$custom_ts find lego_gem_drum_grn_body.mesh} kCopyDeep}
            {prism_gem_kick_miss.mesh copy {$custom_ts find prism_gem_kick_miss.mesh} kCopyDeep}
            {prism_gem_drum_miss.mesh copy {$custom_ts find lego_gem_drum_mis_body.mesh} kCopyDeep}
            {prism_gem_kick_style.mesh copy {$custom_ts find prism_gem_kick_style.mesh} kCopyDeep}
            {prism_gem_drum_style.mesh copy {$custom_ts find lego_gem_drum_nrg_body.mesh} kCopyDeep}
            {prism_gem_kick.mesh copy {$custom_ts find prism_gem_kick.mesh} kCopyDeep}
            {prism_gem_drum_green.mesh copy {$custom_ts find lego_gem_drum_grn_body.mesh} kCopyDeep}
            {prism_gem_drum_blue.mesh copy {$custom_ts find lego_gem_drum_blu_body.mesh} kCopyDeep}
            {prism_gem_drum_yellow.mesh copy {$custom_ts find lego_gem_drum_yel_body.mesh} kCopyDeep}
            {prism_gem_drum_red.mesh copy {$custom_ts find lego_gem_drum_red_body.mesh} kCopyDeep}

            {foreach $color (red yellow blue green star)
               {do
                  ($wid {sprintf "drum_%s.wid" $color})
                  {if {== {size {$wid get_array meshes}} 2}
                     {$wid remove (meshes 1)}
                  }
               }
            }

            {gem_kick.wid insert (meshes 1) {$custom_ts find prism_gem_kick_glow.mesh}}
            {star_kick.wid insert (meshes 1) {$custom_ts find prism_gem_kick_glow_style.mesh}}
            {kick_miss.wid insert (meshes 1) {$custom_ts find prism_gem_kick_miss_glow.mesh}}
         }
      )
      (rb3
         {set $custom_ts {load_objects "ulti/track/tracksystems/rb3/gems.milo"}}
         {with $custom_ts
            {gem.mat set emissive_map prism_gem_emissive.tex}
            {gem.mat set emissive_multiplier 1}
            {kick.mat set emissive_map prism_gem_emissive.tex}
            {kick.mat set emissive_multiplier 1}
            {kick.mat set specular_rgb {pack_color 1 1 1}}
            {kick.mat set specular_power 1.26}
            {cymbal.mat set emissive_map gem_cymbal_ems.tex}
            {cymbal.mat set emissive_multiplier 1}
            ;{style_glow.mat z_mode kZModeDisable} ; this should fix the transparancy issues but it doesn't
         }
         {foreach $gtr (guitar bass)
            {with {coop_track_panel find $gtr}

               {foreach $color (green red yellow blue orange)
                  {do
                     ($wid {sprintf "gem_%s.wid" $color})
                     ($hopo_wid {sprintf "gem_%s_hopo.wid" $color})
                     {while {size {$wid get_array meshes}}
                        {$wid remove (meshes 0)}
                     }
                     {while {size {$hopo_wid get_array meshes}}
                        {$hopo_wid remove (meshes 0)}
                     }
                     {$wid insert (meshes 0) {$custom_ts find {sprintf "_prism_gem_stepped_%s.mesh_0.mesh" $color}}}
                     {$hopo_wid insert (meshes 0) {$custom_ts find {sprintf "_prism_gem_hopo_%s.mesh_0.mesh" $color}}}
                  }
               }

               {while {size {star_gem.wid get_array meshes}}
                  {star_gem.wid remove (meshes 0)}
               }
               ;{star_gem.wid insert (meshes 0) {$custom_ts find _prism_gem_guitar_style_glow.mesh_0.mesh}}
               {star_gem.wid insert (meshes 0) {$custom_ts find _prism_gem_stepped_style.mesh_0.mesh}}

               {while {size {star_hopo.wid get_array meshes}}
                  {star_hopo.wid remove (meshes 0)}
               }
               ;{star_hopo.wid insert (meshes 0) {$custom_ts find _prism_gem_hopo_style_glow.mesh_0.mesh}}
               {star_hopo.wid insert (meshes 0) {$custom_ts find _prism_gem_hopo_style.mesh_0.mesh}}
            }
         }
         {with {coop_track_panel find drum}
            {foreach $color (red yellow blue green)
               {do
                  ($wid {sprintf "drum_%s.wid" $color})
                  {while {size {$wid get_array meshes}}
                     {$wid remove (meshes 0)}
                  }
                  {$wid insert (meshes 0) {$custom_ts find {sprintf "_prism_gem_drum_%s.mesh_0.mesh" $color}}}
               }
            }

            {while {size {drum_star.wid get_array meshes}}
               {drum_star.wid remove (meshes 0)}
            }
            ;{drum_star.wid insert (meshes 0) {$custom_ts find _prism_gem_drum_style_glow.mesh_0.mesh}}
            {drum_star.wid insert (meshes 0) {$custom_ts find _prism_gem_drum_style.mesh_0.mesh}}

            {while {size {gem_kick.wid get_array meshes}}
               {gem_kick.wid remove (meshes 0)}
            }
            {gem_kick.wid insert (meshes 0) {$custom_ts find _prism_gem_kick_glow.mesh_0.mesh}}
            {gem_kick.wid insert (meshes 0) {$custom_ts find _prism_gem_kick.mesh_0.mesh}}

            {while {size {star_kick.wid get_array meshes}}
               {star_kick.wid remove (meshes 0)}
            }
            {star_kick.wid insert (meshes 0) {$custom_ts find _prism_gem_kick_style_glow.mesh_0.mesh}}
            {star_kick.wid insert (meshes 0) {$custom_ts find _prism_gem_kick_style.mesh_0.mesh}}

            {while {size {dynamic_crash_gem.wid get_array meshes}}
               {dynamic_crash_gem.wid remove (meshes 0)}
            }
            {dynamic_crash_gem.wid insert (meshes 0) {$custom_ts find _prism_gem_drum_green.mesh_0.mesh}}
         }
      )
      (gh2
         {set $custom_ts {load_objects "ulti/track/tracksystems/gh2/gems.milo"}} ; gems stolen from rb3dx
         {{$custom_ts find gem.mat} set intensify TRUE}
         {foreach $gtr (guitar bass)
            {with {{get_track_panel} find $gtr}
               {foreach $color (green red yellow blue orange)
                  {do
                     ($wid {sprintf "gem_%s.wid" $color})
                     ($hopo_wid {sprintf "gem_%s_hopo.wid" $color})
                     {while {size {$wid get_array meshes}}
                        {$wid remove (meshes 0)}
                     }
                     {while {size {$hopo_wid get_array meshes}}
                        {$hopo_wid remove (meshes 0)}
                     }
                     {$wid insert (meshes 0) {$custom_ts find {sprintf "strum_%s.mesh" $color}}}
                     {$hopo_wid insert (meshes 0) {$custom_ts find {sprintf "hopo_%s.mesh" $color}}}
                  }
               }

               {while {size {star_gem.wid get_array meshes}}
                  {star_gem.wid remove (meshes 0)}
               }
               {star_gem.wid insert (meshes 0) {$custom_ts find strum_style.mesh}}
               {star_gem.wid insert (meshes 0) {$custom_ts find strum_style_1.mesh}}

               {while {size {star_hopo.wid get_array meshes}}
                  {star_hopo.wid remove (meshes 0)}
               }
               {star_hopo.wid insert (meshes 0) {$custom_ts find hopo_style.mesh}}
               {star_hopo.wid insert (meshes 0) {$custom_ts find hopo_style_1.mesh}}
            }
         }
      )
   }
}
#endif